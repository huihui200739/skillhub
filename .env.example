# openJiuwen market_place (example)
#
# =============================================================================
# MARKET_PLACE SERVICE
# =============================================================================

# -----------------------------------------------------------------------------
# [服务基础配置]
# 必填
# -----------------------------------------------------------------------------
STORE_HOST=0.0.0.0
STORE_PORT=8100
# 可选：对应 plugins_market.core.config.Settings.debug（env 名 MARKET_ + debug）。未设置时默认为 true。
# true 时 marketplace/main.py 会开启 uvicorn reload（开发热重载）；生产建议显式设为 false，关闭 reload。
# MARKET_DEBUG=false

# 可选：接口日志开关，默认 true（开启）。设为 false 则不记录 interface.log
# INTERFACE_LOG_ENABLED=true

# 可选：隐私声明 Markdown 路径（UTF-8）。未设置时默认读取 marketplace/privacy-statement.md。
# GET /api/v1/site/privacy-statement 直接返回 Markdown 正文（非 JSON），供浏览器新标签查看。
# 支持：MARKET_PRIVACY_STATEMENT_FILE 或 PRIVACY_STATEMENT_FILE

# -----------------------------------------------------------------------------
# [数据库配置]
# 必填（DB_TYPE 当前仅支持 mysql）
# -----------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
STORE_DB_NAME=openjiuwen_market
# 可选：整串覆盖（与 DB_TYPE 拼装二选一），
# STORE_DB_URL=mysql+pymysql://user:password@localhost:3306/openjiuwen_market?charset=utf8mb4

# 可选：Redis（多实例部署必须配置，单实例可留空）
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码统一读取 MARKET_REDIS_PASSWORD（通过 SecurityUtils 解密/透传）：
# - 未配置 SERVER_AES_MASTER_KEY：此处可填明文密码
# - 已配置 SERVER_AES_MASTER_KEY：此处应填密文（由安全模块解密后使用）
MARKET_REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# [鉴权配置]
# 必填：Bearer 校验依赖该接口（默认 GitCode）
# -----------------------------------------------------------------------------
AUTH_USER_API_URL=https://gitcode.com/api/v5/user

# 可选：与请求头 X-System-Token 比对（二选一鉴权时使用）
SYSTEM_ADMIN_TOKEN=
# 可选：管理员请求时作为 user_id/publisher_id 使用
SYSTEM_ADMIN_USER=system_admin

# 可选：Skill 上架审核管理员 GitCode 用户名。逗号分隔，或 JSON 数组，例如：alice,bob 或 ["alice","bob"]。非空时优先生效
# MARKET_REVIEW_ADMIN_USERNAMES=alice,bob

# -----------------------------------------------------------------------------
# [GitCode OAuth — 插件市场前端浏览器登录]
# 需在 GitCode 开放平台注册应用；回调 URL 须与 MARKET_GITCODE_OAUTH_REDIRECT_URI 完全一致
# 例：http://localhost:8100/api/v1/auth/oauth/gitcode/callback
# -----------------------------------------------------------------------------
MARKET_GITCODE_OAUTH_ENABLED=false
MARKET_GITCODE_OAUTH_CLIENT_ID=
MARKET_GITCODE_OAUTH_CLIENT_SECRET=
MARKET_GITCODE_OAUTH_REDIRECT_URI=http://127.0.0.1:8100/api/v1/auth/oauth/gitcode/callback

# -----------------------------------------------------------------------------
# [GitHub OAuth — 插件市场前端浏览器登录]
# 需在 GitHub OAuth Apps 注册应用；回调 URL 须与 MARKET_GITHUB_OAUTH_REDIRECT_URI 完全一致
# 例：http://localhost:8100/api/v1/auth/oauth/github/callback
# -----------------------------------------------------------------------------
MARKET_GITHUB_OAUTH_ENABLED=false
MARKET_GITHUB_OAUTH_CLIENT_ID=
MARKET_GITHUB_OAUTH_CLIENT_SECRET=
MARKET_GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8100/api/v1/auth/oauth/github/callback
MARKET_GITHUB_OAUTH_SCOPE=read:user user:email
# 授权成功后浏览器重定向到此前缀下的 /login?oauth_session=...（须与前端访问前缀一致；有 /hub 则写 .../hub，根路径部署则不要 /hub）
MARKET_OAUTH_FRONTEND_ORIGIN=http://127.0.0.1:9002

# -----------------------------------------------------------------------------
# [对象存储配置]
# 仅支持 MinIO | OBS（本地默认 MinIO，云端常用 OBS）
# -----------------------------------------------------------------------------
# 必填：对象存储基础项
STORAGE_TYPE=MinIO
MARKET_BUCKET_NAME=openjiuwen-market-test
MARKET_S3_ENDPOINT=http://localhost:9000
# static（MinIO 默认 / OBS 可显式）：永久 AK/SK
MARKET_S3_ACCESS_KEY=
MARKET_S3_SECRET_KEY=

# 凭证模式：未设置时 MinIO 默认 static，OBS 默认 dynamic
# MARKET_CREDENTIALS_MODE=
# OBS static：仅用上方 MARKET_S3_* 永久密钥
# OBS dynamic：用下方 HUAWEICLOUD_* 调 IAM 接口获取临时 AK/SK（无需填 MARKET_S3_*）
# 可选：IAM 临时凭证会话时长（秒），默认 3600。OBS dynamic 时建议 ≥ MARKET_S3_PRESIGNED_EXPIRES（默认 1800，且不超过云上限）
# MARKET_S3_STS_DURATION_SECONDS=3600

# 必填（OBS）/可选（MinIO）：S3 区域
MARKET_S3_REGION=

# 可选：显式覆盖 SSL
# - MinIO 默认推断为 false
# - OBS 默认推断为 true（如需可手动填 true/false）
MARKET_S3_USE_SSL=

# 可选：GET 预签名有效期（秒），默认 1800（30 分钟）；范围见 s3_storage_client
# MARKET_S3_PRESIGNED_EXPIRES=1800

# 发布页「下载模板」：私有桶内 zip 对象 Key（须已上传）；留空则 GET /api/v1/plugins/publish-template 返回 503
# MARKET_PLUGIN_TEMPLATE_OBJECT_KEY=static/plugin-templates/demo-tools.zip
# Skill 模板（前端 /profile/publish?kind=skill「下载模板」）；留空则 kind=skill 时同上接口返回 503
# MARKET_SKILL_TEMPLATE_OBJECT_KEY=static/plugin-templates/demo-skill.zip

# Git 源创建/同步（POST /plugins/git-sources、POST .../sync）按用户滑动窗口限流（每分钟），0 关闭；多 worker 各进程独立计数
# 服务端需已安装 git 且在 PATH 中（用于 git fetch）
# MARKET_GIT_SOURCE_SYNC_RATE_LIMIT_PER_MINUTE=30

# -----------------------------------------------------------------------------
# [敏感信息加解密配置（AES + HuaweiCloud KMS）]
# -----------------------------------------------------------------------------
# - SERVER_AES_MASTER_KEY: Base64 编码的 32 字节 AES 根密钥
SERVER_AES_MASTER_KEY=

# --- KMS Config for Secret Protection
# 是否启用 KMS 模式（True/False）
HUAWEICLOUD_KMS_ENABLED=False
# 华为云IAM配置
HUAWEICLOUD_USERNAME=your_username
HUAWEICLOUD_DOMAIN_NAME=your_domain
HUAWEICLOUD_IAM_ENDPOINT=

# 华为云项目配置
HUAWEICLOUD_PROJECT_NAME=your_project_name
HUAWEICLOUD_PROJECT_ID=your_project_id
HUAWEICLOUD_REGION=your_region

# 华为云KMS配置
HUAWEICLOUD_KMS_KEY_ID=your_kms_key_id
HUAWEICLOUD_KMS_ENDPOINT=
HUAWEICLOUD_KMS_ENCRYPTION_ALGORITHM=RSAES_OAEP_SHA_256

SECURITY_APPLICATION_SECRET_CACHE_ENABLED=true
SECURITY_APPLICATION_SECRET_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# [检索模块：向量检索 / LLM 配置]
# 启用 embedding / hybrid 检索时必填；仅用 BM25 检索时可留空
# -----------------------------------------------------------------------------
# Embedding 模型
MARKET_RETRIEVAL_EMBEDDING_API_BASE_URL=
MARKET_RETRIEVAL_EMBEDDING_API_KEY=
MARKET_RETRIEVAL_EMBEDDING_MODEL=
MARKET_RETRIEVAL_EMBEDDING_BATCH_SIZE=16

# LLM（progressive / hybrid 检索时使用，纯 BM25 / embedding 可不填）
MARKET_RETRIEVAL_MODEL_API_BASE_URL=
MARKET_RETRIEVAL_MODEL_API_KEY=
MARKET_RETRIEVAL_DEFAULT_LLM_MODEL=
MARKET_RETRIEVAL_FINDER_LLM_BASE_URL=
MARKET_RETRIEVAL_FINDER_LLM_MODEL=

# 独立的技能标签分类 LLM 配置（用于 build_skill_tags）
# 不配置时复用上方主 LLM 配置；配置时使用独立的 API 端点和密钥
MARKET_RETRIEVAL_SKILL_TAG_LLM_MODEL=        # 标签分类用的 LLM 模型
MARKET_RETRIEVAL_SKILL_TAG_LLM_API_BASE_URL= # 标签分类用的 API 端点
MARKET_RETRIEVAL_SKILL_TAG_LLM_API_KEY=      # 标签分类用的 API 密钥

# 离线索引构建策略（默认 embedding_bm25）
#   bm25           仅构建 BM25 关键词索引，不需要 embedding / LLM
#   embedding      仅构建向量索引，需配 EMBEDDING_API_KEY
#   embedding_bm25 构建向量 + BM25 索引（推荐默认），需配 EMBEDDING_API_KEY
#   all            在 embedding_bm25 基础上额外构建 tree 索引，需同时配 LLM 和 EMBEDDING_API_KEY
# MARKET_RETRIEVAL_BUILD_METHOD=embedding_bm25

# 在线检索策略（默认 embedding）
#   bm25        纯关键词检索，最快，无需 embedding / LLM
#   embedding   向量检索 + BM25 兜底，需构建时包含 embedding 索引（推荐默认）
#   auto        自动降级：有 LLM → progressive+embedding+bm25；无 LLM → embedding+bm25；无 embedding → bm25
#   progressive LLM 树状检索，精度最高但延迟高，需构建时包含 tree 索引（即 BUILD_METHOD=all）
# MARKET_RETRIEVAL_SEARCH_METHOD=embedding

# 召回过滤阈值
# 向量相对分阈值（0~1）：仅保留 score >= best_score * 阈值 的候选
# MARKET_RETRIEVAL_EMBEDDING_RELATIVE_MIN_SCORE=0.75

# BM25 最少命中 query 词数量：0 表示不过滤，推荐从 1 起调
# MARKET_RETRIEVAL_BM25_MIN_QUERY_TERM_MATCHES=1

# 检索索引定时重建（cron 默认每小时整点）
# MARKET_RETRIEVAL_REBUILD_CRON=0 * * * *
# MARKET_RETRIEVAL_REBUILD_ON_STARTUP=false
# 技能标签分类定时任务（默认每分钟）
# MARKET_RETRIEVAL_SKILL_TAG_CRON=* * * * *
# MARKET_RETRIEVAL_SKILL_TAG_ON_STARTUP=false

# OBS 上保留的索引版本数（默认 168 = 每小时构建一次保留最近一周，用于回滚）
# MARKET_RETRIEVAL_INDEX_MAX_VERSIONS=168

# =============================================================================
# SKILL REVIEW
# =============================================================================
# Skill 发布后自动审查总开关。默认关闭；需要系统审查时显式改为 true。
MARKET_SKILL_REVIEW_ENABLED=false

# Skill 静态审查语义模型配置（OpenAI-compatible Chat Completions）。
# 仅在 MARKET_SKILL_REVIEW_ENABLED=true 时需要；开启系统审查后必须配置完整，否则 Skill 发布会被前置拒绝。
MARKET_SKILL_REVIEW_MODEL_BASE_URL=
MARKET_SKILL_REVIEW_MODEL_API_KEY=
MARKET_SKILL_REVIEW_MODEL_NAME=
MARKET_SKILL_REVIEW_MODEL_TIMEOUT_SECONDS=300

# =============================================================================
# FRONTEND (plugin market, Vite)
# =============================================================================
# 前端端口
FRONTEND_PORT=9002

# 站点 URL 路径前缀（不要首尾斜杠）。留空 = 根路径（与 Docker 不传 build-arg 默认一致）；需要 /hub 时设为 hub
# FRONTEND_BASE_PATH=hub

# 前端开发（Vite）与前端 Docker 镜像（Nginx）共用：API 上游主机与端口（不要写 http://）
# - 本地 npm run dev：/api 会代理到 http://BACKEND_URL:BACKEND_PORT
# - 前端容器：Nginx 将 /api/ 反代到 BACKEND_URL:BACKEND_PORT（见 docker/Dockerfile.skillhub-frontend）
# =============================================================================
BACKEND_URL=localhost
BACKEND_PORT=8100

# =============================================================================
