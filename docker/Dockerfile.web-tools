# 构建上下文：仓库根目录
#   docker build -f docker/Dockerfile.web-tools -t agent-tools-frontend:latest .

# -----------------------------------------------------------------------------
# Stage 1: 构建 Vite 前端（envDir 为 frontend 上级目录，需在 /app 写入 .env）
# 默认：根路径（无 /hub）。FRONTEND_BASE_PATH 置空 → Vite base=/；VITE_API_BASE_URL=/api/v1
# 带 /hub 示例：--build-arg FRONTEND_BASE_PATH=hub --build-arg VITE_API_BASE_URL=/hub/api/v1
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

ARG FRONTEND_BASE_PATH=
ARG VITE_API_BASE_URL=/api/v1
ENV FRONTEND_BASE_PATH=${FRONTEND_BASE_PATH}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

WORKDIR /app

# Vite loadEnv 从 frontend 的上一级加载
RUN printf '%s\n' "VITE_API_BASE_URL=${VITE_API_BASE_URL}" "FRONTEND_BASE_PATH=${FRONTEND_BASE_PATH}" > .env

COPY frontend/package.json frontend/package-lock.json ./frontend/
WORKDIR /app/frontend
RUN npm ci

COPY frontend ./

RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2：Nginx 托管静态资源；/api/ 反代由环境变量 BACKEND_URL + BACKEND_PORT 配置（与 agent-studio 一致）
# 官方镜像会对 /etc/nginx/templates/*.template 做 envsubst
# FRONTEND_BASE_PATH 为空：使用 default.root.conf.template；非空（如 hub）：使用 default.hub.conf.template
# -----------------------------------------------------------------------------
FROM nginx:alpine

ARG FRONTEND_BASE_PATH=
ENV FRONTEND_BASE_PATH=${FRONTEND_BASE_PATH}

COPY --from=builder /app/frontend/dist /tmp/frontend-dist
RUN if [ -z "$FRONTEND_BASE_PATH" ]; then \
      cp -a /tmp/frontend-dist/. /usr/share/nginx/html/; \
    else \
      mkdir -p "/usr/share/nginx/html/${FRONTEND_BASE_PATH}" && cp -a /tmp/frontend-dist/. "/usr/share/nginx/html/${FRONTEND_BASE_PATH}/"; \
    fi \
    && rm -rf /tmp/frontend-dist

COPY frontend/nginx/nginx.conf /etc/nginx/nginx.conf
COPY frontend/nginx/default.hub.conf.template /tmp/nginx-hub.template
COPY frontend/nginx/default.root.conf.template /tmp/nginx-root.template
# 部分 nginx:alpine 镜像不包含 /etc/nginx/templates，需先创建（官方 entrypoint 仍从此处 envsubst）
RUN mkdir -p /etc/nginx/templates \
    && if [ -z "$FRONTEND_BASE_PATH" ]; then \
      cp /tmp/nginx-root.template /etc/nginx/templates/default.conf.template; \
    else \
      cp /tmp/nginx-hub.template /etc/nginx/templates/default.conf.template; \
    fi \
    && rm -f /tmp/nginx-hub.template /tmp/nginx-root.template

# 默认值：无后端时仍可启动；访问宿主机上的 API 请改为 host.docker.internal 等
ENV BACKEND_URL=localhost
ENV BACKEND_PORT=8100

RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 9002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:9002/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
