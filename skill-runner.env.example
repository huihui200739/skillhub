# =============================================================================
# skill-runner 服务专属环境变量示例
# =============================================================================
# 适用范围：独立部署的 skill-runner 微服务进程（控制面）以及由它拉起的 worker pod（local executor）。
# 与 marketplace 后端的 .env 互不影响——marketplace 的 .env.example 只保留：
#   - PLAYGROUND_ENABLED       (marketplace 决定是否注册 /api/v1/playground/* 路由)
#   - SKILL_RUNNER_URL         (marketplace 反向代理转发到 skill-runner 的地址)
#   - PLAYGROUND_DAILY_LIMIT   (marketplace 侧的每日配额计数)
# 本文件以下字段都由 skill-runner 进程自己读取，**不要**塞进 marketplace 的 ConfigMap。
#
# 部署时建议：
#   - 本地开发：复制为 skill-runner/.env，docker run / uvicorn 时 --env-file 指向它
#   - K8s：用单独的 ConfigMap + Secret（API key 走 Secret），挂载到 skill-runner Deployment
# =============================================================================


# -----------------------------------------------------------------------------
# LLM 配置（前缀 SKILL_RUNNER_LLM_*，与 marketplace / retrieval 完全隔离）
# -----------------------------------------------------------------------------
# 未设时进程内部会回退到通用名 LLM_* / API_*（不推荐，仅为旧部署兼容）。
SKILL_RUNNER_LLM_PROVIDER=OpenAI
SKILL_RUNNER_LLM_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
# ⚠️ 真实 API Key 严禁 commit，K8s 部署请放 Secret，本地 .env 也加入 .gitignore
SKILL_RUNNER_LLM_API_KEY=
SKILL_RUNNER_LLM_MODEL_NAME=doubao-seed-2-0-code
SKILL_RUNNER_LLM_TIMEOUT=120
SKILL_RUNNER_LLM_MAX_ITERATIONS=1000
SKILL_RUNNER_LLM_TEMPERATURE=0.3


# -----------------------------------------------------------------------------
# 执行器
# -----------------------------------------------------------------------------
# k8s   = 控制面进程，每个 session 起一个 worker pod（生产 / KIND 集群推荐）
# local = worker pod 内部，由 worker Dockerfile 自动设置，不要在控制面手动写 local
SKILL_RUNNER_EXECUTOR=k8s


# -----------------------------------------------------------------------------
# k8s executor（SKILL_RUNNER_EXECUTOR=k8s 时生效）
# 详见 docker/skill-agent-worker/RUNBOOK.md
# 默认值按"本地 Docker Desktop Kubernetes"给定，可直接用；生产按注释改
# -----------------------------------------------------------------------------
# worker pod 镜像（仓库根目录构建：
#   docker build -f skillhub/docker/skill-agent-worker/Dockerfile -t skill-agent-worker:latest .）
# SKILL_RUNNER_K8S_POD_IMAGE=skill-agent-worker:0.1.0

# 本地镜像 IfNotPresent；生产推 registry 用 Always
# SKILL_RUNNER_K8S_IMAGE_PULL_POLICY=IfNotPresent

# runtimeClass：留空用集群默认；需更强隔离可设 kata
# SKILL_RUNNER_K8S_RUNTIME_CLASS=

# SKILL_RUNNER_K8S_NAMESPACE=default

# worker pod 回连控制面 LLM 代理的地址（真 key 不进 pod）：
#   本地控制面在宿主 → host.docker.internal
#   生产 in-cluster   → http://skill-runner:8900
# SKILL_RUNNER_PROXY_BASE_URL=http://host.docker.internal:8900

# 私有镜像仓库 pull secret，多个用英文逗号分隔，例如 regcred,mirrorcred
# SKILL_RUNNER_K8S_IMAGE_PULL_SECRETS=

# worker pod ServiceAccount；留空则用 namespace default
# SKILL_RUNNER_K8S_SERVICE_ACCOUNT=

# JSON 对象，例如 {"pool":"sandbox"}
# SKILL_RUNNER_K8S_NODE_SELECTOR=

# JSON 数组，例如 [{"key":"sandbox","operator":"Exists","effect":"NoSchedule"}]
# SKILL_RUNNER_K8S_TOLERATIONS=

# JSON 对象，例如 {"requests":{"cpu":"250m","memory":"512Mi"},"limits":{"cpu":"1","memory":"1Gi"}}
# SKILL_RUNNER_K8S_RESOURCES=
